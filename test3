int fputc(int ch, FILE *f)
{
    (void)f;
    uart_tx_done = false;
    g_uart7.p_api->write(g_uart7.p_ctrl, (const uint8_t *)&ch, 1);
    volatile uint32_t timeout = 10000;
    while((!uart_tx_done) && (timeout-- > 0));
    return ch;
}
