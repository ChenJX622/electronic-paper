#include "hal_data.h"
#include <stdio.h>
#include <stdint.h>
#include "ADC_MY.h"




double val=0.0f;

static volatile bool uart_tx_done = false;
static volatile i2c_master_event_t g_i2c_event = I2C_MASTER_EVENT_ABORTED;
static volatile uint32_t timeout_ms = 500;

void uart7_callback(uart_callback_args_t *p_args)
{
    if (UART_EVENT_TX_COMPLETE == p_args->event) uart_tx_done = true;
}

void sci_i2c2_master_callback(i2c_master_callback_args_t *p_args)
{
    g_i2c_event = p_args->event;
}

//void adc0_callback(adc_callback_args_t *p_args) {(void)p_args;}
void uart8_callback(uart_callback_args_t *p_args) {(void)p_args;}
void uart3_callback(uart_callback_args_t *p_args) {(void)p_args;}
void gpt0_overflow_callback(timer_callback_args_t *p_args) {(void)p_args;}

int fputc(int ch, FILE *f)
{
    (void)f;
    uart_tx_done = false;
    g_uart7.p_api->write(g_uart7.p_ctrl, (const uint8_t *)&ch, 1);
    volatile uint32_t timeout = 10000;
    while((!uart_tx_done) && (timeout-- > 0));
    return ch;
}

static fsp_err_t i2c_write(uint8_t dev_addr, uint8_t *p_data, uint32_t len, bool restart)
{
    fsp_err_t err;
    g_i2c_event = I2C_MASTER_EVENT_ABORTED;
    timeout_ms = 500;
    err = g_i2c2.p_api->write(g_i2c2.p_ctrl, p_data, len, dev_addr);
    if(FSP_SUCCESS != err) return err;
    while((I2C_MASTER_EVENT_TX_COMPLETE != g_i2c_event) && timeout_ms)
    {
        R_BSP_SoftwareDelay(1, BSP_DELAY_UNITS_MILLISECONDS);
        timeout_ms--;
    }
    if(timeout_ms == 0) return FSP_ERR_TIMEOUT;
    return FSP_SUCCESS;
}

static fsp_err_t i2c_read(uint8_t dev_addr, uint8_t *p_data, uint32_t len, bool restart)
{
    fsp_err_t err;
    g_i2c_event = I2C_MASTER_EVENT_ABORTED;
    timeout_ms = 500;
    err = g_i2c2.p_api->read(g_i2c2.p_ctrl, p_data, len, dev_addr);
    if(FSP_SUCCESS != err) return err;
    while((I2C_MASTER_EVENT_RX_COMPLETE != g_i2c_event) && timeout_ms)
    {
        R_BSP_SoftwareDelay(1, BSP_DELAY_UNITS_MILLISECONDS);
        timeout_ms--;
    }
    if(timeout_ms == 0) return FSP_ERR_TIMEOUT;
    return FSP_SUCCESS;
}



void hal_entry(void)
{

			ADC_Init();
    while(1)
    {
			
			val=Read_ADC_Voltage_Value();


        R_BSP_SoftwareDelay(1000, BSP_DELAY_UNITS_MILLISECONDS);
    }

#if BSP_TZ_SECURE_BUILD
    R_BSP_NonSecureEnter();
#endif
}